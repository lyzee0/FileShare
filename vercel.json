{
  "version": 2,
  "builds": [
    {
      "src": "api/webhook.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/webhook.py"
    }
  ],
  "env": {
    "API_ID": "@api_id",
    "API_HASH": "@api_hash",
    "BOT_TOKEN": "@bot_token",
    "MONGODB_URI": "@mongodb_uri",
    "CHANNEL_ID": "@channel_id",
    "OWNER_ID": "@owner_id"
  }
}
